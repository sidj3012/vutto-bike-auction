# Local Docker Compose development only. NEVER reuse these secrets in production.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://auction:local_dev_only@db:5432/auction
REDIS_URL=redis://redis:6379/0
APP_SECRET=replace_me_with_at_least_32_random_characters_before_production
WEB_ORIGIN=http://localhost:3000
API_BACKEND_URL=http://api:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
COOKIE_SECURE=false
METRICS_TOKEN=local_metrics_secret
# Needed only when running the manual seed command
ADMIN_EMAIL=admin@auction.local
ADMIN_PASSWORD=ChangeMeBeforeUsing123!
